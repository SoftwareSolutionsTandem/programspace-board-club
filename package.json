{
  "name": "programspace-board-club",
  "private": true,
  "version": "0.1.0",
  "description": "Игротека (рабочее название): мультяшный сборник классических настольных игр с озвученными персонажами",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
