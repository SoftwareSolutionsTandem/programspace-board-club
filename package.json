{
  "name": "programspace-board-club",
  "private": true,
  "version": "0.1.0",
  "description": "Игротека (рабочее название): мультяшный сборник классических настольных игр с озвученными персонажами",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:durak": "vite --mode durak",
    "dev:dominoes": "vite --mode dominoes",
    "dev:chess": "vite --mode chess",
    "dev:checkers": "vite --mode checkers",
    "build": "vite build",
    "build:igroteka": "vite build",
    "build:durak": "vite build --mode durak",
    "build:dominoes": "vite build --mode dominoes",
    "build:chess": "vite build --mode chess",
    "build:checkers": "vite build --mode checkers",
    "build:all": "npm run build:igroteka && npm run build:durak && npm run build:dominoes && npm run build:chess && npm run build:checkers",
    "preview": "vite preview",
    "preview:durak": "vite preview --mode durak",
    "preview:dominoes": "vite preview --mode dominoes",
    "preview:chess": "vite preview --mode chess",
    "preview:checkers": "vite preview --mode checkers",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run check:assets && npm test && npm run build:all && npm run check:bundle",
    "check:assets": "node tools/check-audio-licenses.mjs",
    "check:bundle": "node tools/check-bundle.mjs igroteka durak dominoes chess checkers",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.17",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
